# Copie ce fichier en .env pour le développement local.
# En production, ces valeurs se règlent dans EAS (commande : npx eas-cli@latest env:set).
# Les variables EXPO_PUBLIC_* sont incluses dans l'app : n'y mets JAMAIS de secret.

# ---------- Backend ----------
# "local" : tout fonctionne sur le téléphone, avec des classements de démonstration.
# "supabase" : vrais classements, duels, votes et modération (obligatoire pour la sortie publique).
EXPO_PUBLIC_BACKEND=local
EXPO_PUBLIC_SUPABASE_URL=
# Clé publique Supabase (`sb_publishable_...`, ou clé `anon` héritée). Elle est faite pour être dans l'app :
# la sécurité repose sur les règles RLS de supabase/migrations.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Publicité (AdMob) ----------
# Vides = identifiants de TEST de Google (aucun revenu, aucun risque).
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
# Identifiants d'application AdMob, lus au moment du build (pas dans le code).
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# ---------- Achats intégrés (RevenueCat) ----------
# Vides = le pack sans pub est masqué.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ---------- Liens ----------
EXPO_PUBLIC_PRIVACY_URL=https://tuparlesjeune.app/confidentialite
EXPO_PUBLIC_TERMS_URL=https://tuparlesjeune.app/cgu
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://tuparlesjeune.app/supprimer-mon-compte
EXPO_PUBLIC_SHARE_BASE_URL=https://tuparlesjeune.app
EXPO_PUBLIC_SUPPORT_EMAIL=contact@tuparlesjeune.app

# ---------- Build ----------
APP_BUNDLE_ID=com.logiqueprod.tuparlesjeune
